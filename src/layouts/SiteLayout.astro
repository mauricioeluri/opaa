---
import '../styles/global.css'
import type { ComponentProps } from 'astro/types'
import { ClientRouter } from 'astro:transitions'
import NavigationProgress from '../components/NavigationProgress.astro'
import SEO from '../components/SEO.astro'
import Topbar from '../components/Topbar.astro'
import PixModal from '../components/PixModal.astro'
import Footer from '../components/Footer.astro'
import AnimalNotice from '../components/AnimalNotice.astro'

type Props = ComponentProps<typeof SEO>
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/branding/opaa-icon.svg" />
    <link rel="icon" type="image/x-icon" href="/branding/opaa-icon.ico" />
    <link rel="apple-touch-icon" href="/branding/opaa-apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...Astro.props} />
    <script is:inline>
      // Modal history must be handled before ClientRouter starts a page swap.
      if (!window.__opaaModalHistory) {
        window.__opaaModalHistory = true
        window.addEventListener('popstate', (event) => {
          const modalHistory = new Event('route-modal:history', { cancelable: true })
          if (!window.dispatchEvent(modalHistory)) event.stopImmediatePropagation()
        }, true)
      }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body id="inicio">
    <NavigationProgress />
    <Topbar />
    <slot />
    <Footer />
    {Astro.url.pathname === '/' && <AnimalNotice />}
    <PixModal />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 120px;
  }

  body {
    box-sizing: border-box;
    padding-top: 64px;
  }

  html:has(dialog[open]) {
    overflow: hidden;
  }

  @media (max-width: 63.999rem) {
    html {
      scroll-padding-top: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
