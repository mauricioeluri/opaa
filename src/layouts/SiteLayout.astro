---
import '../styles/global.css'
import type { ComponentProps } from 'astro/types'
import lilitaOne from '@fontsource/lilita-one/files/lilita-one-latin-400-normal.woff2?url'
import nunitoSans from '@fontsource/nunito-sans/files/nunito-sans-latin-400-normal.woff2?url'
import { ClientRouter } from 'astro:transitions'
import NavigationProgress from '../components/NavigationProgress.astro'
import SEO from '../components/SEO.astro'
import Topbar from '../components/Topbar.astro'
import PixModal from '../components/PixModal.astro'
import Footer from '../components/Footer.astro'
import AnimalNotice from '../components/home/AnimalNotice.astro'

type Props = ComponentProps<typeof SEO> & {
  /** Only the content: no navigation, footer or Pix (for the "unavailable" page). */
  bare?: boolean
}

const { bare = false, ...seo } = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/branding/opaa-icon.svg" />
    <link rel="icon" type="image/x-icon" href="/branding/opaa-icon.ico" />
    <link rel="apple-touch-icon" href="/branding/opaa-apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {[lilitaOne, nunitoSans].map((href) => (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={href}
        crossorigin=""
      />
    ))}
    <SEO {...seo} />
    <noscript>
      <style is:inline>
        #contribuir:not([open]) {
          display: block;
          position: static;
          margin: 32px auto;
          max-height: none;
        }
        #contribuir .close-form {
          display: none;
        }
      </style>
    </noscript>
    <script is:inline>
      // Modal history must be handled before ClientRouter starts a page swap.
      if (!window.__opaaModalHistory) {
        window.__opaaModalHistory = true
        window.addEventListener(
          'popstate',
          (event) => {
            const modalHistory = new Event('route-modal:history', {
              cancelable: true,
            })
            if (!window.dispatchEvent(modalHistory))
              event.stopImmediatePropagation()
          },
          true
        )
      }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body id="inicio" class:list={{ bare }}>
    <NavigationProgress />
    {!bare && <Topbar />}
    <slot />
    {!bare && <Footer />}
    {!bare && Astro.url.pathname === '/' && <AnimalNotice />}
    {!bare && <PixModal />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 120px;
  }

  body {
    box-sizing: border-box;
    padding-top: 64px;
  }

  body.bare {
    padding-top: 0;
  }

  html:has(dialog[open]) {
    overflow: hidden;
  }

  @media (max-width: 63.999rem) {
    html {
      scroll-padding-top: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
