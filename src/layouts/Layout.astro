---
import SEO from '../components/SEO.astro'
interface Props {
  title?: string
  description?: string
  noindex?: boolean
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/branding/opaa-icon.svg" />
    <link rel="icon" type="image/x-icon" href="/branding/opaa-icon.ico" />
    <link rel="apple-touch-icon" href="/branding/opaa-apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...Astro.props} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
