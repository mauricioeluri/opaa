---
import AnimalsPage from '../../components/animals/AnimalsPage.astro'

const { content } = Astro.locals
const [animal, animals] = await Promise.all([
  content.getAvailableAnimal(Astro.params.id!),
  content.getAvailableAnimals(),
])
if (!animal) return new Response(null, { status: 404 })
---

<AnimalsPage animals={animals} animal={animal} />
