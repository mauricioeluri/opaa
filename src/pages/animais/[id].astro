---
import type { InferGetStaticPropsType } from 'astro'
import AnimalsPage from '../../components/AnimalsPage.astro'
import { getAvailableAnimals } from '../../lib/api'

export async function getStaticPaths() {
  return (await getAvailableAnimals()).map((animal) => ({
    params: { id: animal.public_id },
    props: { animal },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>
const { animal } = Astro.props
---

<AnimalsPage animal={animal} />
