---
import { Heart } from '@lucide/astro'
import PageHeader from '../components/PageHeader.astro'
import BrandIcon from '../components/BrandIcon.astro'
import { site } from '../config/site'
import SiteLayout from '../layouts/SiteLayout.astro'
import { getStories } from '../lib/api'
import { formatDate } from '../lib/format-date'
import { getWhatsAppUrl } from '../lib/whatsapp'

const stories = await getStories()
const contactUrl = getWhatsAppUrl(
  site.phone,
  'Oi, pessoal! Quero compartilhar uma história feliz com vocês! Posso enviar uma foto e um texto curtinho por aqui?'
)
---

<SiteLayout
  title={`Histórias felizes | ${site.name}`}
  description="Fotos, carinho e momentos felizes de quem faz parte da história da OPAA Alegrete. Compartilhe a sua também!"
>
  <main>
    <PageHeader
      label="Histórias felizes"
      title="Cada vida, uma nova página"
      description="Veja por onde andam os animais que receberam nosso cuidado. Tem uma história com a OPAA? Conte pra gente!"
      icon={Heart}
    >
      <a
        slot="actions"
        class="button"
        href={contactUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <BrandIcon src="/icons/whatsapp.svg" size={20} />
        Envie sua história
      </a>
    </PageHeader>

    {stories.length > 0 ? (
      <section class="stories" aria-label="Últimas histórias felizes">
        {stories.map((story, index) => (
          <article
            aria-label={`História publicada em ${formatDate(story.published_at)}`}
          >
            <figure class:list={{ 'with-comparison': story.beforeImage }}>
              <span class="paper-top" aria-hidden="true"></span>
              <div class:list={['photos', { comparison: story.beforeImage }]}>
                {story.beforeImage && (
                  <div class="photo">
                    <span class="photo-label">Antes</span>
                    <span class="photo-mount">
                      <img
                        src={story.beforeImage}
                        alt={`Foto anterior de ${story.name}`}
                        loading={index < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </span>
                  </div>
                )}
                <div class="photo">
                  {story.beforeImage && <span class="photo-label">Hoje</span>}
                  <span class="photo-mount">
                    <img
                      src={story.afterImage}
                      alt={`Foto atual de ${story.name}`}
                      loading={index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </span>
                </div>
              </div>
              <figcaption>
                <p>{story.description}</p>
                <time datetime={story.published_at}>
                  {formatDate(story.published_at)}
                </time>
              </figcaption>
            </figure>
          </article>
        ))}
      </section>
    ) : (
      <p class="empty-state">
        As primeiras histórias chegam em breve. Que tal enviar a sua?
      </p>
    )}
  </main>
</SiteLayout>

<style>
  main {
    max-width: 1040px;
    margin-inline: auto;
    padding: 80px 24px 64px;
  }

  p {
    margin: 0;
  }

  .stories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 40px 20px;
  }

  article {
    display: grid;
    min-width: 0;
  }

  figure {
    position: relative;
    box-sizing: border-box;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin: 0;
    padding: 12px;
    background: var(--color-surface);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 25px,
      color-mix(in srgb, var(--color-primary) 6%, transparent) 25px 26px
    );
    background-position: 0 10px;
    filter: drop-shadow(
      2px 5px 3px color-mix(in srgb, var(--color-primary) 10%, transparent)
    );
  }

  figure::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: -21px;
    left: calc(50% - 30px);
    width: 60px;
    height: 28px;
    background: color-mix(in srgb, var(--color-primary) 20%, transparent);
    transform: rotate(-6deg);
    clip-path: polygon(3% 0, 100% 5%, 97% 95%, 0 100%);
    pointer-events: none;
  }

  figure::after,
  .paper-top {
    content: '';
    position: absolute;
    right: 0;
    bottom: -13px;
    left: 0;
    height: 14px;
    background: var(--color-surface);
    clip-path: polygon(
      0 0,
      100% 0,
      100% 38%,
      97% 73%,
      92% 90%,
      88% 50%,
      85% 64%,
      81% 70%,
      77% 40%,
      73% 100%,
      69% 62%,
      65% 55%,
      61% 35%,
      58% 78%,
      55% 90%,
      50% 58%,
      47% 25%,
      43% 70%,
      38% 75%,
      34% 100%,
      30% 50%,
      26% 78%,
      22% 88%,
      18% 28%,
      15% 50%,
      11% 95%,
      7% 75%,
      4% 40%,
      0 100%
    );
    pointer-events: none;
  }

  .paper-top {
    top: -13px;
    bottom: auto;
    transform: rotate(180deg);
  }

  .photos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    flex: 1 1 auto;
    min-width: 0;
    width: max-content;
    max-width: 100%;
  }

  .with-comparison {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .comparison {
    display: flex;
    justify-content: center;
    gap: 12px;
    width: auto;
  }

  .photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .photo-label {
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 12px;
  }

  .photo-mount {
    position: relative;
    display: block;
    width: max-content;
    max-width: 100%;
  }

  .photo-mount::before,
  .photo-mount::after {
    content: '';
    position: absolute;
    z-index: 1;
    width: 18px;
    height: 18px;
    background: var(--color-primary);
    pointer-events: none;
  }

  .photo-mount::before {
    top: -4px;
    left: -4px;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .photo-mount::after {
    right: -4px;
    bottom: -4px;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .comparison .photo {
    flex: 0 1 auto;
    justify-content: start;
  }

  .comparison img {
    max-height: 180px;
  }

  img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 280px;
    outline: 4px solid var(--color-surface);
    box-shadow: 0 2px 5px color-mix(in srgb, var(--color-text) 17%, transparent);
  }

  figcaption {
    flex: 1 1 max(200px, calc(100% - 240px));
    min-width: 0;
    overflow-wrap: anywhere;
  }

  figcaption p {
    white-space: pre-line;
  }

  time {
    display: block;
    margin-top: 8px;
    color: var(--color-muted);
    font-size: 12px;
  }

  .empty-state {
    padding: 24px;
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 60rem) {
    .stories {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.999rem) {
    main {
      padding: 32px 16px 48px;
    }
  }
</style>
