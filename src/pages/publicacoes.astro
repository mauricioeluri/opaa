---
import { ArrowUpRight, BookOpen, Search } from '@lucide/astro'
import PageHeader from '../components/PageHeader.astro'
import FilterPanel from '../components/FilterPanel.astro'
import ContentImage from '../components/ContentImage.astro'
import { site } from '../config/site'
import SiteLayout from '../layouts/SiteLayout.astro'
import { formatDate } from '../lib/format-date'
import { postCategories } from '../lib/post-category'

const posts = await Astro.locals.content.getPosts()
const categories = [...new Set(posts.map((post) => post.category))]
---

<SiteLayout
  title={`Publicações | ${site.name}`}
  description="Acompanhe as ações, parcerias e resultados da OPAA Alegrete. Notícias de quem cuida dos animais junto com a comunidade."
>
  <main class="publications">
    <PageHeader
      label="Publicações"
      title="O cuidado acontece todos os dias"
      description="Ações, encontros e conquistas de quem faz a OPAA acontecer. Venha acompanhar de perto."
      icon={BookOpen}
    />

    {posts.length > 0 ? (
      <>
        <FilterPanel>
          <form
            class="filters"
            role="search"
            aria-label="Buscar publicações"
            hidden
          >
            <label class="search-field">
              Buscar publicação
              <span class="search-input">
                <Search size={18} aria-hidden="true" />
                <input
                  type="search"
                  name="search"
                  placeholder="O que você procura?"
                  aria-controls="publication-list"
                />
              </span>
            </label>
            <label>
              Categoria
              <select name="category" aria-controls="publication-list">
                <option value="">Todas as categorias</option>
                {categories.map((category) => (
                  <option value={category}>
                    {postCategories[category] ?? 'Publicações'}
                  </option>
                ))}
              </select>
            </label>
          </form>
          <p
            slot="count"
            class="result-count"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            {posts.length === 1
              ? '1 publicação'
              : `${posts.length} publicações`}
          </p>
        </FilterPanel>
        <section
          class="posts"
          id="publication-list"
          aria-label="Publicações da OPAA"
        >
          {posts.map((post) => (
            <article
              id={post.slug}
              data-category={post.category}
              aria-labelledby={`title-${post.slug}`}
            >
              <a class="post-link" href={`/publicacoes/${post.slug}/`}>
                {post.image && (
                  <ContentImage
                    class="cover"
                    src={post.image}
                    alt=""
                    width={320}
                    sizes="(max-width: 35rem) 88px, 120px"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="post-copy">
                  <div class="metadata">
                    <span class="category">
                      {postCategories[post.category] ?? 'Publicações'}
                    </span>
                    <time datetime={post.published_at}>
                      {formatDate(post.published_at)}
                    </time>
                  </div>
                  <h2 id={`title-${post.slug}`}>{post.title}</h2>
                  <p class="preview">{post.body}</p>
                  <span class="read-more">
                    Ler publicação <ArrowUpRight size={16} aria-hidden="true" />
                  </span>
                </div>
              </a>
            </article>
          ))}
        </section>
        <p class="empty-state" hidden>
          Não encontramos publicações com essa busca. Tente outra palavra ou
          categoria.
        </p>
      </>
    ) : (
      <p class="empty-state">
        As primeiras publicações chegam em breve. Volte para conferir!
      </p>
    )}
  </main>
</SiteLayout>

<script>
  import { onPageLoad } from '../lib/page-lifecycle'

  onPageLoad(() => {
    const listing = document.querySelector<HTMLElement>('.publications')
    const form = listing?.querySelector<HTMLFormElement>('.filters')
    const search = form?.querySelector<HTMLInputElement>('input')
    const category = form?.querySelector<HTMLSelectElement>('select')
    const count = listing?.querySelector<HTMLElement>('.result-count')
    const empty = listing?.querySelector<HTMLElement>('.empty-state')
    if (!listing || !form || !search || !category || !count || !empty) return

    const normalize = (text: string) =>
      text
        .normalize('NFD')
        .replace(/\p{Diacritic}/gu, '')
        .toLocaleLowerCase('pt-BR')
    const posts = Array.from(
      listing.querySelectorAll<HTMLElement>('article')
    ).map((element) => ({
      element,
      text: normalize(element.textContent || ''),
    }))
    const update = () => {
      const terms = normalize(search.value).trim().split(/\s+/).filter(Boolean)
      let visible = 0
      posts.forEach(({ element, text }) => {
        element.hidden =
          (category.value !== '' &&
            element.dataset.category !== category.value) ||
          !terms.every((term) => text.includes(term))
        if (!element.hidden) visible++
      })
      count.textContent =
        visible === 1 ? '1 publicação' : `${visible} publicações`
      empty.hidden = visible > 0
    }

    form.hidden = false
    form.addEventListener('submit', (event) => event.preventDefault())
    search.addEventListener('input', update)
    category.addEventListener('change', update)
    update()
  })
</script>

<style>
  main {
    max-width: 1120px;
    margin-inline: auto;
    padding: 80px 24px 64px;
  }

  .filters:not([hidden]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 20px;
    margin-top: 16px;
  }

  label {
    display: grid;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
  }

  input,
  select {
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 16px;
    font-weight: 400;
  }

  .search-input {
    position: relative;
  }

  .search-input :global(svg) {
    position: absolute;
    top: 15px;
    left: 14px;
    color: var(--color-primary);
    pointer-events: none;
  }

  input {
    padding-left: 42px;
  }

  .result-count {
    margin: 20px 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  .posts {
    display: grid;
    gap: 16px;
  }

  article:not([hidden]) {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 24px 8px 24px 8px;
    background: var(--color-surface);
    scroll-margin-top: 100px;
  }

  .post-link {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding: 20px;
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }

  .post-link:hover h2 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-link:not(:has(.cover)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .cover {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100px;
    margin-inline: auto;
    border-radius: 10px;
  }

  .post-copy {
    min-width: 0;
  }

  .metadata {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-bottom: 8px;
    color: var(--color-muted);
    font-size: 12px;
  }

  .category {
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--color-soft);
    color: var(--color-primary);
  }

  h2 {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-size: 20px;
  }

  .preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    color: var(--color-primary);
    font-size: 14px;
  }

  .empty-state:not([hidden]) {
    padding: 32px;
    border: 1px dashed var(--color-border);
    border-radius: 16px;
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 47.999rem) {
    main {
      padding: 32px 16px 48px;
    }

    .filters:not([hidden]) {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .post-link {
      grid-template-columns: 88px minmax(0, 1fr);
      align-items: start;
      gap: 16px;
      padding: 16px;
    }

    .cover {
      max-height: 88px;
    }

    h2 {
      font-size: 18px;
    }
  }
</style>
