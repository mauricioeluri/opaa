---
import { site } from '../config/site'
import SiteLayout from '../layouts/SiteLayout.astro'

const title = 'Ué… cadê essa página?'
const description =
  'Até nosso farejador ficou sem pistas. Vamos procurar no início?'
---

<SiteLayout title={`${title} | ${site.name}`} description={description} noindex>
  <main>
    <img
      src="/images/confused-dog.gif"
      alt="Cachorro olhando ao redor, confuso, procurando alguma coisa"
      width="360"
      height="360"
    />
    <div>
      <h1>{title}</h1>
      <p>{description}</p>
      <a class="button" href="/">
        Voltar ao início
      </a>
    </div>
  </main>
</SiteLayout>

<style>
  main {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    max-width: 960px;
    min-height: 50vh;
    margin-inline: auto;
    padding: 64px 24px;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: clamp(32px, 4vw, 40px);
  }

  p {
    margin: 16px 0 24px;
  }

  @media (max-width: 47.999rem) {
    main {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding: 48px 16px;
      text-align: center;
    }

    img {
      max-width: 240px;
      justify-self: center;
    }
  }
</style>
