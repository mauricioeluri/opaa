---
import ShopPage from '../../components/shop/ShopPage.astro'

const { content } = Astro.locals
const [product, products] = await Promise.all([
  content.getProduct(Astro.params.id!),
  content.getProducts(),
])
if (!product) return new Response(null, { status: 404 })
---

<ShopPage products={products} product={product} />
