---
import StatusPage from '../components/StatusPage.astro'

// Unexpected errors come from Astro as `error`; an unreachable API comes from
// the middleware, which also answers 503. Only the developer sees the message
// (see StatusPage).
const error: unknown = Astro.locals.contentError ?? Astro.props.error
const detail = error instanceof Error ? error.message : undefined
Astro.response.headers.set('Cache-Control', 'no-store')
---

<StatusPage
  title="Ué… nosso farejador perdeu a trilha"
  description="Não conseguimos buscar o conteúdo agora. Ele já está atrás do cheiro de novo, tente outra vez em instantes!"
  imageAlt="Cachorro olhando ao redor, confuso, procurando alguma coisa"
  action={{ href: Astro.url.pathname, label: 'Tentar de novo' }}
  detail={detail}
  bare
/>
