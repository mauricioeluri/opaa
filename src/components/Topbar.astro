---
import { Menu, X } from '@lucide/astro'
import { site } from '../config/site'

const pathname = Astro.url.pathname.replace(/\/$/, '')
const items = [
  { label: 'Animais', section: 'animais', page: '/animais' },
  { label: 'Castração', section: 'castracao' },
  { label: 'Comunicados', section: 'comunicados' },
  { label: 'Novidades', section: 'novidades' },
  { label: 'Loja solidária', section: 'loja' },
  {
    label: 'Histórias felizes',
    section: 'historias-felizes',
    page: '/historias-felizes',
  },
]
---

<header class="topbar">
  <div class="container">
    <a
      class="brand"
      href="/#inicio"
      aria-label={`${site.name} — página inicial`}
    >
      <img src="/branding/opaa-logo.svg" alt="" width="48" height="48" />
      <span>{site.name}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label="Abrir menu"
      hidden
    >
      Menu
      <span class="open-icon" aria-hidden="true">
        <Menu size={20} />
      </span>
      <span class="close-icon" aria-hidden="true">
        <X size={20} />
      </span>
    </button>

    <nav id="main-navigation" aria-label="Navegação principal">
      <div class="navigation-content">
        <ul>
          {items.map((item) => {
            const isCurrentPage = pathname === item.page
            const isDetailPage =
              item.page && pathname.startsWith(`${item.page}/`)

            return (
              <li>
                {isCurrentPage ? (
                  <span aria-current="page">{item.label}</span>
                ) : (
                  <a
                    href={isDetailPage ? `${item.page}/` : `/#${item.section}`}
                    data-section={item.section}
                    aria-current={isDetailPage ? 'location' : undefined}
                  >
                    {item.label}
                  </a>
                )}
              </li>
            )
          })}
          <li>
            <button class="button help-link" type="button" data-open-pix hidden>
              Quero ajudar
            </button>
            <noscript>
              <a class="button help-link" href="#contribuir">
                Quero ajudar
              </a>
            </noscript>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  import { onPageLoad } from '../lib/page-lifecycle'

  onPageLoad(() => {
    const header = document.querySelector<HTMLElement>('.topbar')
    const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle')
    const navigation = header?.querySelector<HTMLElement>('nav')

    if (header && toggle && navigation) {
      const desktop = window.matchMedia('(min-width: 64rem)')
      const sectionLinks = Array.from(
        navigation.querySelectorAll<HTMLAnchorElement>('a[data-section]')
      ).flatMap((link) => {
        const section = document.getElementById(link.dataset.section || '')
        return section ? [{ link, section }] : []
      })

      const updateScrollState = () => {
        header.dataset.scrolled = String(window.scrollY > 40)
        const atBottom =
          window.scrollY + window.innerHeight >=
          document.documentElement.scrollHeight - 2
        const active = atBottom
          ? sectionLinks.at(-1)
          : sectionLinks.findLast(({ section }) => {
              const bounds = section.getBoundingClientRect()
              return bounds.top <= 160 && bounds.bottom > 64
            })
        sectionLinks.forEach(({ link }) => {
          if (link === active?.link) {
            link.setAttribute('aria-current', 'location')
          } else {
            link.removeAttribute('aria-current')
          }
        })
      }

      updateScrollState()
      window.addEventListener('scroll', updateScrollState, { passive: true })
      window.addEventListener('resize', updateScrollState)

      const setMenuOpen = (open: boolean) => {
        header.dataset.menuOpen = String(open)
        toggle.setAttribute('aria-expanded', String(open))
        toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu')
        navigation.inert = !desktop.matches && !open
      }

      const closeMenu = () => setMenuOpen(false)

      closeMenu()
      toggle.hidden = false

      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true'
        setMenuOpen(open)
      })

      header.addEventListener('keydown', (event) => {
        if (
          event.key === 'Escape' &&
          toggle.getAttribute('aria-expanded') === 'true'
        ) {
          event.preventDefault()
          closeMenu()
          toggle.focus()
        }
      })

      navigation.addEventListener('click', (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest('a, [data-open-pix]')
        )
          closeMenu()
      })

      desktop.addEventListener('change', closeMenu)

      return () => {
        window.removeEventListener('scroll', updateScrollState)
        window.removeEventListener('resize', updateScrollState)
        desktop.removeEventListener('change', closeMenu)
      }
    }
  })
</script>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    color: var(--color-text);
    background: var(--color-background);
  }

  .container {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1120px;
    margin-inline: auto;
    min-height: 64px;
    padding-inline: 24px;
  }

  .brand {
    position: relative;
    display: block;
    width: 108px;
    height: 48px;
    min-width: 0;
    font-weight: 700;
    text-decoration: none;
  }

  .brand img {
    position: absolute;
    top: 0;
    width: 108px;
    height: 108px;
    z-index: 1;
    transform-origin: top left;
    transition: transform 240ms ease;
  }

  .brand span {
    display: none;
    overflow-wrap: anywhere;
  }

  nav {
    grid-column: 2;
    align-self: stretch;
  }

  li:last-child {
    position: absolute;
    top: 10px;
    right: 24px;
  }

  a {
    color: inherit;
  }

  ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  nav a,
  nav span[aria-current] {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    padding-inline: 16px;
    font-size: 15px;
    text-decoration: none;
  }

  nav a:not(.button):hover,
  nav [aria-current] {
    color: var(--color-primary);
    background: var(--color-soft);
  }

  nav .help-link {
    min-height: 44px;
    padding-block: 0;
  }

  .menu-toggle {
    display: none;
  }

  .open-icon,
  .close-icon {
    display: flex;
    width: 20px;
    height: 20px;
  }

  .menu-toggle[aria-expanded='false'] .close-icon,
  .menu-toggle[aria-expanded='true'] .open-icon {
    display: none;
  }

  @media (min-width: 64rem) {
    .topbar[data-scrolled='true'] .brand img {
      transform: scale(calc(48 / 108));
    }

    .navigation-content,
    ul {
      height: 100%;
    }

    ul {
      align-items: stretch;
    }

    li:not(:last-child) {
      display: flex;
    }

    nav a:not(.help-link),
    nav span[aria-current] {
      box-sizing: border-box;
      height: 100%;
      border-radius: 0;
    }
  }

  @media (max-width: 63.999rem) {
    .topbar {
      max-height: 100svh;
      overflow-y: auto;
    }

    .container {
      display: flex;
      flex-wrap: wrap;
      gap: 0 12px;
      padding: 10px 16px;
      min-height: 44px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      flex: 1;
      gap: 8px;
      width: auto;
      height: auto;
    }

    .brand span {
      display: inline;
    }

    .brand img {
      position: static;
      flex-shrink: 0;
      width: 40px;
      height: 40px;
    }

    .menu-toggle:not([hidden]) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      padding: 8px 12px;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      font: inherit;
      color: inherit;
      background: transparent;
      cursor: pointer;
    }

    nav {
      display: grid;
      grid-template-rows: 1fr;
      flex-basis: 100%;
      visibility: visible;
      transition:
        grid-template-rows 240ms ease,
        visibility 0s;
    }

    .navigation-content {
      min-height: 0;
      overflow: hidden;
    }

    .topbar[data-menu-open='false'] nav {
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows 240ms ease,
        visibility 0s 240ms;
    }

    .topbar[data-menu-open='false'] ul {
      opacity: 0;
      transform: translateY(-8px);
    }

    ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      max-height: calc(100svh - 64px);
      overflow-y: auto;
      transition:
        opacity 200ms ease,
        transform 240ms ease;
    }

    li:last-child {
      position: static;
    }

    nav a,
    nav span[aria-current] {
      min-height: 48px;
      justify-content: flex-start;
    }

    nav .help-link {
      justify-content: center;
      margin-block: 8px 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand img,
    nav,
    .topbar[data-menu-open='false'] nav,
    ul {
      transition: none;
    }
  }
</style>
