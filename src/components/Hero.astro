---
import { site } from '../config/site'
import PhotoSlider from './PhotoSlider.astro'
import SectionDivider from './SectionDivider.astro'
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="content">
      <h1 id="hero-title">Juntos, cuidamos de quem precisa de proteção</h1>
      <p class="description">
        Atuamos na proteção animal em Alegrete com castrações a baixo custo,
        resgates, orientação e ações solidárias. Com a sua ajuda, esse cuidado
        chega mais longe.
      </p>
    </div>
    <PhotoSlider label="A OPAA em ação" images={site.heroSlides} autoplay />
  </div>
  <SectionDivider position="top" />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--color-soft);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -1;
    width: 30%;
    background: var(--color-primary);
    border-radius: 120px 0 0;
  }

  .container {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 0.9fr 1.15fr;
    align-items: center;
    gap: 48px;
    max-width: 1168px;
    margin-inline: auto;
    padding: 80px 24px 48px;
  }

  .content {
    min-width: 0;
  }

  p {
    margin: 0;
  }

  h1 {
    margin: 0 0 24px;
    max-width: 19ch;
    font-size: clamp(32px, 4vw, 48px);
    color: var(--color-primary);
    text-wrap: balance;
  }

  .description {
    max-width: 52ch;
  }

  @media (max-width: 55rem) {
    .container {
      gap: 32px;
    }
  }

  @media (max-width: 47.999rem) {
    .hero::before {
      inset: auto 0 0;
      width: 100%;
      height: 28%;
      border-radius: 64px 0 0;
    }

    .container {
      grid-template-columns: minmax(0, 1fr);
      padding: 32px 16px;
    }
  }
</style>
