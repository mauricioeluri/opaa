---
import { site } from '../config/site'
---

<main>
  <img src="/branding/opaa-logo.svg" alt={site.name} width="200" height="200" />
  <h1>{site.name}</h1>
  <p>{site.slogan}</p>
</main>

<style>
  main {
    box-sizing: border-box;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    text-align: center;
    color: var(--color-text);
    background: var(--color-background);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h1 {
    margin: 24px 0 8px;
    font-size: 32px;
  }

  p {
    margin: 0;
    line-height: 1.5;
  }
</style>
