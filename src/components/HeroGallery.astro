---
import { ChevronLeft, ChevronRight, Pause, Play } from '@lucide/astro'

const slides = [
  {
    image: '/landing-page/membros.jpg',
    width: 1200,
    height: 675,
    alt: 'Membros da OPAA reunidos com balões que representam os resultados de 2025',
    caption:
      'Parceria com a Prefeitura: em 2025, foram 981 castrações e 338 adoções.',
  },
  {
    image: '/landing-page/galeto.jpg',
    width: 1168,
    height: 880,
    alt: 'Grupo reunido durante a realização de um galeto beneficente da OPAA',
    caption:
      'Galeto beneficente: a comunidade reunida para apoiar a proteção animal.',
  },
]
---

<section
  class="gallery"
  aria-label="A OPAA em ação"
  aria-roledescription="carrossel"
>
  <button
    type="button"
    class="playback"
    aria-label="Pausar apresentação"
    aria-controls="hero-slides"
    hidden
  >
    <span class="pause-icon">
      <Pause size={18} aria-hidden="true" />
    </span>
    <span class="play-icon">
      <Play size={18} aria-hidden="true" />
    </span>
  </button>
  <div class="slides" id="hero-slides">
    {slides.map((slide, index) => (
      <figure
        class="slide"
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} de ${slides.length}`}
      >
        <img
          src={slide.image}
          alt={slide.alt}
          width={slide.width}
          height={slide.height}
        />
        <figcaption>
          <span>{slide.caption}</span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="controls" hidden>
    <button
      type="button"
      class="previous"
      aria-label="Foto anterior"
      aria-controls="hero-slides"
    >
      <ChevronLeft size={20} aria-hidden="true" />
    </button>
    <span class="status" aria-live="polite" aria-atomic="true">
      Foto 1 de {slides.length}
    </span>
    <button
      type="button"
      class="next"
      aria-label="Próxima foto"
      aria-controls="hero-slides"
    >
      <ChevronRight size={20} aria-hidden="true" />
    </button>
  </div>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('.gallery')

  if (gallery) {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.slide'))
    const controls = gallery.querySelector<HTMLElement>('.controls')
    const status = gallery.querySelector<HTMLElement>('.status')
    const playback = gallery.querySelector<HTMLButtonElement>('.playback')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    let activeIndex = 0
    let autoplay = !reducedMotion.matches
    let hovered = false
    let focused = false
    let timer: number | undefined

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex
        slide.dataset.active = String(active)
        slide.setAttribute('aria-hidden', String(!active))
        slide.inert = !active
      })
      if (status)
        status.textContent = `Foto ${activeIndex + 1} de ${slides.length}`
    }

    const updatePlayback = () => {
      window.clearInterval(timer)
      const running = autoplay && !hovered && !focused && !document.hidden

      if (status) status.setAttribute('aria-live', running ? 'off' : 'polite')
      if (playback) {
        playback.dataset.playing = String(autoplay)
        playback.setAttribute(
          'aria-label',
          autoplay ? 'Pausar apresentação' : 'Iniciar apresentação'
        )
      }

      if (running) {
        timer = window.setInterval(() => showSlide(activeIndex + 1), 6000)
      }
    }

    showSlide(0)
    gallery.dataset.ready = 'true'
    if (controls) controls.hidden = false
    if (playback) playback.hidden = false
    updatePlayback()

    playback?.addEventListener('click', () => {
      autoplay = !autoplay
      focused = false
      updatePlayback()
    })

    gallery.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') {
        hovered = true
        updatePlayback()
      }
    })
    gallery.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') {
        hovered = false
        updatePlayback()
      }
    })
    gallery.addEventListener('focusin', () => {
      focused = true
      updatePlayback()
    })
    gallery.addEventListener('focusout', (event) => {
      if (
        !(event.relatedTarget instanceof Node) ||
        !gallery.contains(event.relatedTarget)
      ) {
        focused = false
        updatePlayback()
      }
    })
    document.addEventListener('visibilitychange', updatePlayback)
    reducedMotion.addEventListener('change', () => {
      autoplay = !reducedMotion.matches
      updatePlayback()
    })

    gallery.querySelector('.previous')?.addEventListener('click', () => {
      showSlide(activeIndex - 1)
      updatePlayback()
    })
    gallery.querySelector('.next')?.addEventListener('click', () => {
      showSlide(activeIndex + 1)
      updatePlayback()
    })
  }
</script>

<style>
  .gallery {
    position: relative;
    min-width: 0;
    color: var(--color-surface);
  }

  .slides {
    display: grid;
  }

  .playback {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
  }

  .playback[hidden],
  .playback[data-playing='true'] .play-icon,
  .playback[data-playing='false'] .pause-icon {
    display: none;
  }

  .play-icon,
  .pause-icon {
    display: flex;
  }

  figure {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 24px;
  }

  .gallery[data-ready='true'] .slide {
    grid-area: 1 / 1;
    transition: opacity 240ms ease;
  }

  .slide[data-active='false'] {
    visibility: hidden;
    opacity: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
  }

  figcaption {
    position: absolute;
    inset: auto 24px 20px;
    text-align: center;
    font-size: 14px;
    line-height: 1.8;
  }

  figcaption span {
    padding: 3px 8px;
    background: color-mix(in srgb, var(--color-text) 85%, transparent);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .controls:not([hidden]) {
    display: flex;
    position: absolute;
    inset: 42% 12px auto;
    transform: translateY(-50%);
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text) 75%, transparent);
    color: var(--color-surface);
    cursor: pointer;
    pointer-events: auto;
  }

  button:hover {
    background: var(--color-primary);
    color: var(--color-surface);
  }

  button:focus-visible {
    outline: 3px solid var(--color-surface);
    outline-offset: 3px;
  }

  @media (max-width: 55rem) and (min-width: 48rem), (max-width: 35rem) {
    img {
      aspect-ratio: 4 / 3;
    }

    figcaption {
      inset: auto 12px 12px;
    }

    .controls:not([hidden]) {
      top: 35%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery[data-ready='true'] .slide {
      transition: none;
    }
  }
</style>
