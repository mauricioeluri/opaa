---
import { Stethoscope } from '@lucide/astro'
import { site } from '../config/site'
import { getWhatsAppUrl } from '../lib/whatsapp'
import BrandIcon from './BrandIcon.astro'

const contactUrl = getWhatsAppUrl(
  site.phone,
  'Oi, pessoal! Gostaria de saber como funciona a castração a baixo custo.'
)
---

<section class="neutering" id="castracao" aria-labelledby="neutering-title">
  <div class="callout">
    <Stethoscope
      class="service-icon"
      size={36}
      stroke-width={1.5}
      aria-hidden="true"
    />
    <div>
      <h2 id="neutering-title">Castração a baixo custo</h2>
      <p>
        Quer castrar seu animal? Fale com a OPAA para saber como funciona o
        atendimento.
        <br />
        <a class="notices-link" href="#comunicados">
          Confira também os comunicados
        </a>{' '}
        sobre vagas e próximas ações.
      </p>
    </div>
    <a
      class="button contact-link"
      href={contactUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <BrandIcon src="/icons/whatsapp.svg" size={18} />
      Falar sobre castração
    </a>
  </div>
</section>

<style>
  .neutering {
    max-width: 1120px;
    margin-inline: auto;
    padding: 0 24px var(--section-gap);
  }

  .callout {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 24px;
    border-radius: 20px;
    background: var(--color-soft);
  }

  .callout :global(.service-icon) {
    color: var(--color-primary);
  }

  h2 {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-size: clamp(24px, 3vw, 28px);
  }

  p {
    margin: 0;
    font-size: 15px;
  }

  .contact-link {
    justify-self: start;
  }

  .notices-link {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .notices-link:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 50rem) {
    .callout {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 16px;
    }

    .contact-link {
      grid-column: 2;
    }
  }

  @media (max-width: 35rem) {
    .neutering {
      padding-inline: 16px;
    }

    .callout {
      grid-template-columns: minmax(0, 1fr);
    }

    .callout :global(.service-icon) {
      display: none;
    }

    .contact-link {
      grid-column: auto;
    }
  }
</style>
