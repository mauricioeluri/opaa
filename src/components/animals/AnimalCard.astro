---
import { Cat, Dog, PawPrint } from '@lucide/astro'
import type { getAllAnimals } from '../../lib/api'
import { getAnimalLabel } from '../../lib/animal-label'
import PhotoSlider from '../PhotoSlider.astro'
import AnimalModal from './AnimalModal.astro'

interface Props {
  animal: Awaited<ReturnType<typeof getAllAnimals>>[number]
  catalog?: boolean
}

const { animal, catalog = false } = Astro.props
const Heading = catalog ? 'h2' : 'h3'
const label = getAnimalLabel(animal)
const images = animal.images.slice(0, 2)
const AnimalIcon =
  animal.type === 'dog' ? Dog : animal.type === 'cat' ? Cat : PawPrint
---

<article
  class:list={['animal', { catalog }]}
  data-male={String(animal.isMale)}
  data-neutered={String(animal.neutered)}
  data-age-group={animal.ageGroup}
  data-animal-type={animal.type}
>
  <AnimalIcon
    class="animal-icon"
    size={72}
    stroke-width={1.25}
    aria-hidden="true"
  />
  <PhotoSlider
    label={label}
    variant="animal"
    images={images.map((src, index) => ({
      src,
      alt: `${label} — foto ${index + 1} de ${images.length}`,
    }))}
  />
  <div class="animal-content">
    <Heading>
      <a class="animal-link" href={`/animais/${animal.public_id}/`}>
        {label}
      </a>
    </Heading>
    <p class="description">{animal.description}</p>
  </div>
</article>
<AnimalModal animal={animal} />

<script>
  import { onPageLoad } from '../../lib/page-lifecycle'
  import { openRouteModal } from '../../lib/route-modal'

  onPageLoad(() => {
    document
      .querySelectorAll<HTMLAnchorElement>('.animal-link')
      .forEach((link) => {
        link.addEventListener('click', (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          )
            return
          if (openRouteModal(new URL(link.href).pathname, link))
            event.preventDefault()
        })
      })
  })
</script>

<style>
  .animal {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    min-width: 0;
    padding: 20px;
    border-radius: 16px;
    background: var(--color-soft);
    cursor: pointer;
  }

  .animal :global(.animal-icon) {
    position: absolute;
    z-index: -1;
    right: 16px;
    bottom: 12px;
    color: var(--color-primary);
    opacity: 0.08;
    transform: rotate(-14deg);
    pointer-events: none;
    user-select: none;
  }

  .animal[hidden] {
    display: none;
  }

  .animal-content {
    min-width: 0;
    max-width: 65ch;
  }

  h2,
  h3 {
    margin: 0 0 8px;
    font-size: 20px;
  }

  p {
    margin: 0;
    font-size: 14px;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  .description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .animal-link {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .animal-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 16px;
  }

  .animal-link:focus-visible::after {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  .animal:hover:not(:has(.image-slider:hover)) .animal-link,
  .animal-link:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  .animal :global(.image-slider) {
    z-index: 2;
    cursor: default;
  }

  .catalog {
    box-sizing: border-box;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 280px 1fr;
    align-items: stretch;
    gap: 20px;
    max-width: 560px;
  }

  .catalog h2 {
    color: var(--color-primary);
    font-size: 26px;
  }

  .catalog .description {
    min-height: 4.8em;
  }

  .catalog :global(.slider-animal .photos) {
    height: 280px;
    aspect-ratio: auto;
  }

  @media (max-width: 35rem) {
    .animal {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
</style>
