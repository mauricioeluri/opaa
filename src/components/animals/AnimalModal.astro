---
import { ChevronLeft, ChevronRight, X } from '@lucide/astro'
import BrandIcon from '../BrandIcon.astro'
import PhotoSlider from '../PhotoSlider.astro'
import { site } from '../../config/site'
import type { Animal } from '../../lib/api'
import { animalAgeGroups, getAnimalLabel } from '../../lib/animal-label'
import { formatDate } from '../../lib/format-date'
import { getWhatsAppUrl } from '../../lib/whatsapp'

interface Props {
  animal: Animal
  index: number
  total: number
  previous?: string
  next?: string
}

const { animal, index, total, previous, next } = Astro.props
const label = getAnimalLabel(animal)
const title = animal.name?.trim() || 'Ainda sem nome'
const sex = animal.isMale ? 'Macho' : 'Fêmea'
const ageGroup = animalAgeGroups[animal.ageGroup]
const animalUrl = new URL(
  `/animais/${animal.public_id}/`,
  Astro.site ?? Astro.url
)
const contactMessage = `Oi, pessoal! Me interessei por este animal. Podemos conversar sobre a adoção?\n\n${animalUrl.href}`
const details = [
  { label: 'Sexo', value: sex },
  { label: 'Faixa etária', value: ageGroup },
  {
    label: 'Idade',
    value: animal.age
      ? `${animal.isAgeApproximate ? 'aprox. ' : ''}${animal.age}`
      : null,
  },
  {
    label: 'Castração',
    value: animal.neutered ? 'Sim' : 'Não',
  },
  { label: 'Vacinas', value: animal.vaccinations },
  { label: 'Publicado em', value: formatDate(animal.published_at) },
].filter((detail) => detail.value?.trim())
---

<dialog
  class="animal-modal"
  aria-labelledby={`animal-title-${animal.public_id}`}
  data-animal-path={`/animais/${animal.public_id}/`}
  open={
    Astro.url.pathname.replace(/\/?$/, '/') === `/animais/${animal.public_id}/`
  }
>
  <form method="dialog" class="close-row">
    <button
      class="close-animal"
      type="submit"
      aria-label="Fechar animal"
      hidden
    >
      <X size={22} aria-hidden="true" />
    </button>
  </form>
  <div class="modal-content">
    <div class="gallery">
      <PhotoSlider
        label={`Fotos de ${label}`}
        variant="animal"
        thumbnails
        images={animal.images.map((image, index) => ({
          ...image,
          alt: `${label} — foto ${index + 1} de ${animal.images.length}`,
        }))}
      />
    </div>

    <div class="animal-content">
      <p class="status">Disponível para adoção</p>
      <h2 id={`animal-title-${animal.public_id}`}>{title}</h2>
      <dl>
        {details.map((detail) => (
          <div>
            <dt>{detail.label}</dt>
            <dd>{detail.value}</dd>
          </div>
        ))}
      </dl>
      <p class="description">{animal.description}</p>
      <a
        class="button"
        href={getWhatsAppUrl(site.phone, contactMessage)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <BrandIcon src="/icons/whatsapp.svg" size={20} />
        Falar com a OPAA pelo WhatsApp
      </a>
      <noscript>
        <a href="/animais/">Ver todos os animais</a>
      </noscript>
    </div>
  </div>
  {total > 1 && (
    <nav class="animal-navigation" aria-label="Navegar entre animais">
      <div class="previous-animal">
        {previous && (
          <a href={`/animais/${previous}/`} data-animal-navigation>
            <ChevronLeft size={18} aria-hidden="true" />
            Animal anterior
          </a>
        )}
      </div>
      <span class="animal-count">
        Animal {index + 1} de {total}
      </span>
      <div class="next-animal">
        {next && (
          <a href={`/animais/${next}/`} data-animal-navigation>
            Próximo animal
            <ChevronRight size={18} aria-hidden="true" />
          </a>
        )}
      </div>
    </nav>
  )}
</dialog>

<script>
  import { isPlainClick } from '../../lib/dom-events'
  import { onPageLoad } from '../../lib/page-lifecycle'
  import { attachRouteModal, openRouteModal } from '../../lib/route-modal'

  onPageLoad(() => {
    const cleanups: (() => void)[] = []
    const controller = new AbortController()
    document
      .querySelectorAll<HTMLDialogElement>('.animal-modal')
      .forEach((dialog) => {
        const path = dialog.dataset.animalPath
        if (!path) return
        const close = dialog.querySelector<HTMLButtonElement>('.close-animal')
        if (close) close.hidden = false
        cleanups.push(attachRouteModal(dialog, path, '/animais/'))
        dialog
          .querySelectorAll<HTMLAnchorElement>('[data-animal-navigation]')
          .forEach((link) => {
            link.addEventListener(
              'click',
              (event) => {
                if (!isPlainClick(event)) return
                if (
                  openRouteModal(new URL(link.href).pathname, undefined, true)
                )
                  event.preventDefault()
              },
              { signal: controller.signal }
            )
          })
      })
    return () => {
      controller.abort()
      cleanups.forEach((cleanup) => cleanup())
    }
  })
</script>

<style>
  .animal-modal {
    box-sizing: border-box;
    width: min(880px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: 24px;
    background: var(--color-surface);
    color: var(--color-text);
    overflow: auto;
    box-shadow: 0 24px 80px
      color-mix(in srgb, var(--color-text) 25%, transparent);
  }

  .animal-modal::backdrop {
    background: color-mix(in srgb, var(--color-text) 60%, transparent);
    backdrop-filter: blur(5px);
  }

  .close-row {
    position: sticky;
    top: 12px;
    z-index: 2;
    display: flex;
    justify-content: end;
    height: 0;
    margin: 0;
    padding-right: 12px;
  }

  .close-animal {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-primary);
    cursor: pointer;
  }

  .close-animal[hidden] {
    display: none;
  }

  .modal-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  }

  .gallery {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 20px;
    background: var(--color-soft);
  }

  .gallery :global(.image-slider) {
    width: 100%;
  }

  .gallery :global(.slider-animal .photos) {
    height: clamp(280px, 52dvh, 480px);
    max-height: none;
    aspect-ratio: auto;
  }

  .animal-content {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .status {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-weight: 700;
  }

  h2 {
    margin: 0;
    padding-right: 24px;
    color: var(--color-primary);
    font-size: 32px;
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin: 24px 0 0;
  }

  dt {
    color: var(--color-muted);
    font-size: 14px;
  }

  dd {
    margin: 0;
    font-weight: 700;
  }

  .description {
    margin: 24px 0;
    white-space: pre-line;
  }

  .button:not([hidden]) {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin-top: auto;
    margin-inline: auto;
  }

  .animal-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 20px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }

  .animal-navigation a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    color: var(--color-primary);
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .animal-navigation a:hover {
    text-decoration: underline;
  }

  .next-animal {
    text-align: right;
  }

  .animal-count {
    color: var(--color-muted);
    text-align: center;
  }

  @media (max-width: 47.999rem) {
    .modal-content {
      grid-template-columns: minmax(0, 1fr);
    }

    .animal-content {
      padding: 24px;
    }

    .gallery {
      padding: 16px;
    }

    .gallery :global(.slider-animal .photos) {
      height: clamp(220px, 38dvh, 340px);
    }

    .animal-navigation {
      grid-template-columns: 1fr 1fr;
      gap: 0 8px;
      padding: 12px 16px;
    }

    .animal-count {
      grid-area: 1 / 1 / 2 / -1;
    }
  }
</style>
