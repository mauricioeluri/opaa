---
import { ArrowRight } from '@lucide/astro'
import { getAvailableAnimals } from '../lib/api'
import AnimalCard from './AnimalCard.astro'

const animals = (await getAvailableAnimals()).slice(0, 2)
---

{animals.length > 0 && (
  <section class="adoption" id="animais" aria-labelledby="adoption-title">
    <header>
      <p class="eyebrow">Adoção responsável</p>
      <h2 id="adoption-title">Seu novo amigo pode estar aqui</h2>
    </header>

    <div class="cards">
      {animals.map((animal) => (
        <AnimalCard animal={animal} />
      ))}
    </div>

    <a class="button view-all" href="/animais/">
      Ver todos os animais disponíveis para adoção
      <ArrowRight size={20} aria-hidden="true" />
    </a>
  </section>
)}

<style>
  .adoption {
    max-width: 1120px;
    margin-inline: auto;
    padding: 24px 24px 64px;
  }

  header {
    margin-bottom: 24px;
  }

  p {
    margin: 0;
    font-size: 14px;
  }

  .eyebrow {
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  h2 {
    margin: 0;
    color: var(--color-primary);
    font-size: clamp(24px, 3vw, 32px);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    align-items: start;
    gap: 24px;
  }

  .view-all.button {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin: 24px auto 0;
    font-size: 16px;
    line-height: 1.35;
  }

  :global(.view-all > svg) {
    flex-shrink: 0;
    margin-left: auto;
  }

  @media (max-width: 35rem) {
    .adoption {
      padding: 24px 16px 48px;
    }
  }
</style>
