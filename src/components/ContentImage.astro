---
import { Image } from 'astro:assets'
import type { HTMLAttributes } from 'astro/types'
import { getContentImage } from '../lib/content-image'

interface Props extends Omit<
  HTMLAttributes<'img'>,
  'src' | 'width' | 'height'
> {
  src: string
  alt: string
  width?: number
  sizes?: string
}

const { src, width, sizes, ...attributes } = Astro.props
const image = await getContentImage(src)
const imageWidth = Math.min(width ?? image.width, image.width)
const imageHeight = Math.round((imageWidth * image.height) / image.width)
const widths = [96, 160, 240, 320, 480, 640, 768, 960, 1200].filter(
  (value) => value < imageWidth
)
widths.push(imageWidth)
const imageProps = {
  ...attributes,
  width: imageWidth,
  height: imageHeight,
  widths,
  sizes: sizes ?? `${imageWidth}px`,
}
---

{typeof image.src === 'string' ? (
  <Image {...imageProps} src={image.src} />
) : (
  <Image {...imageProps} src={image.src} />
)}
