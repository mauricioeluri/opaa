---
import { Image } from 'astro:assets'
import type { HTMLAttributes } from 'astro/types'
import { getContentImage } from '../lib/content-image'

interface Props extends Omit<
  HTMLAttributes<'img'>,
  'src' | 'width' | 'height'
> {
  src: string
  alt: string
  width?: number
  sizes?: string
}

const { src, width, sizes, ...attributes } = Astro.props
const image = await getContentImage(src)
const imageWidth = Math.min(width ?? image.width, image.width)
const widths = [160, 320, 640, 960, 1200].filter((value) => value < imageWidth)
widths.push(imageWidth)
---

<Image
  {...attributes}
  src={image}
  width={imageWidth}
  widths={widths}
  sizes={sizes ?? `${imageWidth}px`}
/>
