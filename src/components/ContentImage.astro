---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> {
  src: string
  alt: string
  width?: number
  sizes?: string
}

const { src, width, sizes, ...attributes } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/public/{api,images}/**/*.{jpg,jpeg,png,webp}'
)
const loadImage = images[`/public${src}`]
if (!loadImage) throw new Error(`Imagem local não encontrada: ${src}`)
const image = (await loadImage()).default
const imageWidth = Math.min(width ?? image.width, image.width)
const widths = [160, 320, 640, 960, 1200].filter((value) => value < imageWidth)
widths.push(imageWidth)
---

<Image
  {...attributes}
  src={image}
  width={imageWidth}
  widths={widths}
  sizes={sizes ?? `${imageWidth}px`}
/>
