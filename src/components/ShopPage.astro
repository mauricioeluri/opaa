---
import { Heart, ShoppingBag } from '@lucide/astro'
import ProductCard from './ProductCard.astro'
import { site } from '../config/site'
import SiteLayout from '../layouts/SiteLayout.astro'
import { getProducts } from '../lib/api'

interface Props {
  product?: Awaited<ReturnType<typeof getProducts>>[number]
}

const { product } = Astro.props
const products = await getProducts()
---

<SiteLayout
  title={`${product?.name ?? 'Loja solidária'} | ${site.name}`}
  description={product?.description ?? 'Conheça os produtos da loja solidária da OPAA Alegrete. Sua compra ajuda a cuidar dos animais.'}
  image={product?.images[0]?.src}
  imageAlt={product ? `Foto de ${product.name}` : undefined}
>
  <main>
    <header class="intro">
      <div class="intro-copy">
        <span class="eyebrow">Loja solidária</span>
        <h1>Leve essa causa com você</h1>
        <p>
          Escolha o seu, fale com a gente e faça seu pedido. A OPAA confirma a
          disponibilidade e combina os detalhes do pedido pelo WhatsApp.
        </p>
      </div>
      <span class="bag" aria-hidden="true">
        <ShoppingBag size={64} stroke-width={1.5} />
        <Heart class="bag-heart" size={22} stroke-width={1.5} />
      </span>
    </header>

    {products.length > 0 ? (
      <section class="products" aria-label="Produtos da loja solidária">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </section>
    ) : (
      <p class="empty-state">
        Novidades chegando por aqui. Volte para conferir!
      </p>
    )}
  </main>
</SiteLayout>

<style>
  main {
    max-width: 1120px;
    margin-inline: auto;
    padding: 80px 24px 64px;
  }

  .intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 32px;
    padding: 32px;
    border-radius: 28px 8px 28px 8px;
    background: var(--color-soft);
  }

  .intro-copy {
    max-width: 65ch;
  }

  .eyebrow {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 4px;
    background: var(--color-primary);
    color: var(--color-surface);
    font-size: 14px;
    transform: rotate(-2deg);
  }

  h1 {
    margin: 16px 0 12px;
    color: var(--color-primary);
    font-size: clamp(32px, 4vw, 44px);
  }

  p {
    margin: 0;
  }

  .bag {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 112px;
    height: 112px;
    border-radius: 24px;
    background: var(--color-surface);
    color: var(--color-primary);
    transform: rotate(8deg);
  }

  .bag :global(.bag-heart) {
    position: absolute;
    top: 54px;
    left: 45px;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: stretch;
    gap: 24px;
  }

  .empty-state {
    padding: 32px;
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 47.999rem) {
    main {
      padding: 32px 16px 48px;
    }

    .intro {
      padding: 24px;
    }

    .bag {
      display: none;
    }
  }
</style>
