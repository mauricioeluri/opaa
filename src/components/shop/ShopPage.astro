---
import { Heart, ShoppingBag } from '@lucide/astro'
import PageHeader from '../PageHeader.astro'
import ProductCard from './ProductCard.astro'
import { site } from '../../config/site'
import SiteLayout from '../../layouts/SiteLayout.astro'
import type { Product } from '../../lib/api'

interface Props {
  products: Product[]
  product?: Product
}

const { products, product } = Astro.props
---

<SiteLayout
  title={`${product?.name ?? 'Loja solidária'} | ${site.name}`}
  description={
    product?.description ??
    'Conheça os produtos da loja solidária da OPAA Alegrete. Sua compra ajuda a cuidar dos animais.'
  }
  image={product?.images[0]?.src}
  imageAlt={product ? `Foto de ${product.name}` : undefined}
>
  <main>
    <PageHeader
      label="Loja solidária"
      title="Leve essa causa com você"
      description="Escolha o seu, fale com a gente e faça seu pedido. A OPAA confirma a disponibilidade e combina os detalhes do pedido pelo WhatsApp."
      icon={ShoppingBag}
      accentIcon={Heart}
    />

    {products.length > 0 ? (
      <section class="products" aria-label="Produtos da loja solidária">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </section>
    ) : (
      <p class="empty-state">
        Novidades chegando por aqui. Volte para conferir!
      </p>
    )}
  </main>
</SiteLayout>

<style>
  main {
    max-width: 1120px;
    margin-inline: auto;
    padding: 80px 24px 64px;
  }

  p {
    margin: 0;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: stretch;
    gap: 24px;
  }

  .empty-state {
    padding: 32px;
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 47.999rem) {
    main {
      padding: 32px 16px 48px;
    }
  }
</style>
