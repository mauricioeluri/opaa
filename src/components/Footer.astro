---
import { Mail, MapPin } from '@lucide/astro'
import { site } from '../config/site'
import { getOrganization } from '../lib/api'
import { formatPhone } from '../lib/format-phone'
import { getGoogleMapsUrl } from '../lib/google-maps'
import { getSocialLinks } from '../lib/social-links'
import { getWhatsAppUrl } from '../lib/whatsapp'

const organization = await getOrganization()
const whatsappUrl = getWhatsAppUrl(organization.phone)
const formattedPhone = formatPhone(organization.phone)
const formattedAddress = `${site.address.streetAddress}, ${site.address.addressLocality} - ${site.address.addressRegion}`
const mapsUrl = getGoogleMapsUrl(
  `${formattedAddress}, ${site.address.addressCountry}`
)
const socialLinks = getSocialLinks(
  organization.facebook,
  organization.instagram
).map((link) => ({
  ...link,
  icon:
    link.label === 'Facebook' ? '/icons/facebook.svg' : '/icons/instagram.svg',
}))
---

<footer class="footer">
  <div class="container">
    <div class="columns">
      <div class="identity">
        <div class="brand">
          <img src="/branding/opaa-logo.svg" alt="" width="64" height="64" />
          <span class="brand-copy">
            <span>{site.name}</span>
            <span class="tagline">Desde 2009, {site.slogan.toLowerCase()}</span>
          </span>
        </div>
        <p>{site.institution}</p>
        <p class="registration">CNPJ: {site.cnpj}</p>
      </div>

      <section aria-labelledby="footer-contact">
        <h2 id="footer-contact">Fale com a OPAA</h2>
        <ul>
          <li>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              <span
                class="social-icon"
                style="--icon: url('/icons/whatsapp.svg')"
                aria-hidden="true"
              ></span>
              <span>{formattedPhone}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${organization.email}`}>
              <Mail size={18} aria-hidden="true" />
              <span>{organization.email}</span>
            </a>
          </li>
          <li>
            <address>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ver ${formattedAddress} no Google Maps`}
              >
                <MapPin size={18} aria-hidden="true" />
                <span>
                  {site.address.streetAddress}
                  <br />
                  {site.address.addressLocality} - {site.address.addressRegion}
                </span>
              </a>
            </address>
          </li>
        </ul>
      </section>

      <nav aria-labelledby="footer-social">
        <h2 id="footer-social">Acompanhe nosso trabalho</h2>
        <ul>
          {socialLinks.map(({ href, label, icon }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer">
                <span
                  class="social-icon"
                  style={`--icon: url('${icon}')`}
                  aria-hidden="true"
                ></span>
                <span>{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="bottom">
      <small>© {new Date().getFullYear()} OPAA</small>
      <a
        href="/docs/opaa-brand-kit.pdf"
        target="_blank"
        rel="noopener noreferrer"
      >
        Kit de marca
      </a>
      <a href="#">Admin</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-soft);
    color: var(--color-text);
    --item-gap: 20px;
    line-height: 24px;
  }

  .container {
    max-width: 1120px;
    margin-inline: auto;
    padding: 48px 24px 20px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    align-items: start;
    justify-content: space-between;
    gap: 32px;
  }

  .columns > * {
    min-width: 0;
    max-width: 320px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 700;
  }

  .brand img {
    flex-shrink: 0;
    width: 64px;
    height: auto;
  }

  .brand-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .tagline {
    font-size: 14px;
    font-weight: 400;
  }

  p {
    margin: 0;
    font-size: 14px;
  }

  .identity {
    display: grid;
    gap: var(--item-gap);
  }

  .registration {
    font-size: 12px;
  }

  h2 {
    margin: 0 0 calc(var(--item-gap) / 2);
    font-size: 16px;
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    color: inherit;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }

  li a {
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: 44px;
    padding-block: calc(var(--item-gap) / 2);
    width: fit-content;
    max-width: 100%;
    font-size: 14px;
    text-decoration: none;
  }

  .social-icon {
    display: block;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 3px;
    background-color: currentColor;
    mask: var(--icon) center / contain no-repeat;
  }

  li a:hover {
    text-decoration: underline;
  }

  address {
    margin: 0;
    font-size: 14px;
    font-style: normal;
    overflow-wrap: anywhere;
  }

  :global(.footer svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .bottom {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 24px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  small {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
  }

  .bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 12px;
  }

  @media (max-width: 55rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

  @media (max-width: 35rem) {
    .container {
      padding: 32px 16px 20px;
    }

    .bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 28px;
    }
  }
</style>
