---
interface Props {
  images: { id?: string; src: string; alt: string; caption?: string }[]
  label: string
  variant?: 'hero' | 'animal' | 'product'
  autoplay?: boolean
  thumbnails?: boolean
}

const {
  images,
  label,
  variant = 'hero',
  autoplay = false,
  thumbnails = false,
} = Astro.props
---

<div
  class:list={['image-slider', `slider-${variant}`]}
  data-autoplay={autoplay}
  role="group"
  aria-label={label}
  aria-roledescription="carrossel"
>
  <div
    class="photos"
    tabindex={images.length > 1 ? 0 : undefined}
    aria-label="Fotos; use as setas do teclado para navegar"
  >
    {images.map((image, index) => (
      <figure data-image-id={image.id}>
        <img
          src={image.src}
          alt={image.alt}
          width="1200"
          height={variant === 'animal' ? 1200 : 675}
          loading={
            index === 0 && (variant === 'hero' || thumbnails) ? 'eager' : 'lazy'
          }
          draggable="false"
        />
        {image.caption && (
          <figcaption>
            <span>{image.caption}</span>
          </figcaption>
        )}
      </figure>
    ))}
  </div>
  {images.length > 1 && (
    <div class:list={['dots', { thumbnails }]} hidden>
      {images.map((image, index) => (
        <button
          type="button"
          class="dot"
          data-image-id={image.id}
          aria-label={`Mostrar foto ${index + 1} de ${images.length}`}
          aria-current={index === 0 ? 'true' : 'false'}
        >
          {thumbnails && (
            <img src={image.src} alt="" width="64" height="64" loading="lazy" />
          )}
        </button>
      ))}
    </div>
  )}
</div>

<script>
  import { onPageLoad } from '../lib/page-lifecycle'

  onPageLoad(() => {
    const cleanups: (() => void)[] = []
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)')

    document
      .querySelectorAll<HTMLElement>('.image-slider')
      .forEach((slider) => {
        const photos = slider.querySelector<HTMLElement>('.photos')
        const dots = Array.from(
          slider.querySelectorAll<HTMLButtonElement>('.dot')
        )
        const controls = slider.querySelector<HTMLElement>('.dots')
        if (!photos || !controls) return

        const automatic = slider.dataset.autoplay === 'true'
        let timer: number | undefined
        let drag: { x: number; scroll: number; index: number } | undefined
        const visibleDots = () => dots.filter((dot) => !dot.hidden)
        const current = () =>
          Math.round(photos.scrollLeft / photos.clientWidth) || 0
        const moveTo = (index: number) => {
          if (visibleDots().length < 2) return
          photos.scrollTo({
            left:
              ((index + visibleDots().length) % visibleDots().length) *
              photos.clientWidth,
            behavior: motion.matches ? 'instant' : 'smooth',
          })
        }
        const updateTimer = () => {
          window.clearInterval(timer)
          if (
            automatic &&
            visibleDots().length > 1 &&
            !drag &&
            !document.hidden
          ) {
            timer = window.setInterval(() => moveTo(current() + 1), 6000)
          }
        }

        controls.hidden = false
        photos.style.touchAction = 'pan-y'
        dots.forEach((dot) =>
          dot.addEventListener('click', () =>
            moveTo(visibleDots().indexOf(dot))
          )
        )
        const filterImages = () => {
          const ids = slider.dataset.visibleImages
          const visibleIds: string[] | undefined = ids
            ? JSON.parse(ids)
            : undefined
          slider
            .querySelectorAll<HTMLElement>('figure, .dot')
            .forEach((item) => {
              item.hidden =
                !!visibleIds && !visibleIds.includes(item.dataset.imageId || '')
            })
          controls.hidden = visibleDots().length < 2
          if (visibleDots().length > 1) photos.tabIndex = 0
          else photos.removeAttribute('tabindex')
          photos.scrollTo({ left: 0, behavior: 'instant' })
          visibleDots().forEach((dot, index) =>
            dot.setAttribute('aria-current', String(index === 0))
          )
          updateTimer()
        }
        slider.addEventListener('photo-slider:filter', filterImages)
        filterImages()
        photos.addEventListener(
          'scroll',
          () => {
            visibleDots().forEach((dot, index) =>
              dot.setAttribute('aria-current', String(index === current()))
            )
          },
          { passive: true }
        )
        photos.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
            event.preventDefault()
            moveTo(current() + (event.key === 'ArrowRight' ? 1 : -1))
          }
        })
        photos.addEventListener('pointerdown', (event) => {
          if (
            !event.isPrimary ||
            event.button !== 0 ||
            visibleDots().length < 2
          )
            return
          window.clearInterval(timer)
          if (event.pointerType === 'mouse') event.preventDefault()
          drag = {
            x: event.clientX,
            scroll: photos.scrollLeft,
            index: current(),
          }
          photos.setPointerCapture(event.pointerId)
          photos.style.scrollSnapType = 'none'
          photos.classList.add('dragging')
        })
        photos.addEventListener('pointermove', (event) => {
          if (drag) photos.scrollLeft = drag.scroll + drag.x - event.clientX
        })
        const endDrag = (event: PointerEvent) => {
          if (drag) {
            const distance = drag.x - event.clientX
            const threshold = Math.min(40, photos.clientWidth * 0.15)
            const step =
              event.type !== 'pointercancel' && Math.abs(distance) >= threshold
                ? Math.sign(distance)
                : 0
            const index = drag.index + step
            drag = undefined
            photos.style.scrollSnapType = ''
            photos.classList.remove('dragging')
            moveTo(index)
          }
          updateTimer()
        }
        photos.addEventListener('pointerup', endDrag)
        photos.addEventListener('pointercancel', endDrag)
        if (automatic) {
          document.addEventListener('visibilitychange', updateTimer)
          cleanups.push(() => {
            window.clearInterval(timer)
            document.removeEventListener('visibilitychange', updateTimer)
          })
          updateTimer()
        }
      })

    return () => cleanups.forEach((cleanup) => cleanup())
  })
</script>

<style>
  .image-slider {
    position: relative;
    min-width: 0;
    color: var(--color-surface);
  }

  .photos {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: default;
  }

  .photos[tabindex] {
    cursor: grab;
  }

  .photos.dragging {
    cursor: grabbing;
  }

  figure[hidden],
  .dot[hidden] {
    display: none;
  }

  .slider-product .photos {
    height: var(--product-photo-height, 240px);
  }

  .slider-product figure:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slider-product .photos img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: auto;
    object-fit: contain;
    border-radius: 12px;
  }

  figure {
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    margin: 0;
    scroll-snap-align: start;
  }

  .photos img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 24px;
    user-select: none;
  }

  figcaption {
    position: absolute;
    inset: auto 16px 36px;
    text-align: center;
    font-size: 14px;
    line-height: 1.8;
  }

  figcaption span {
    padding: 3px 8px;
    background: color-mix(in srgb, var(--color-text) 85%, transparent);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .dots:not([hidden]) {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    padding-inline: 4px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--color-text) 60%, transparent);
  }

  button {
    color: inherit;
    border: 0;
    cursor: pointer;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
  }

  .dot::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }

  .dot[aria-current='true']::after {
    opacity: 1;
  }

  button:focus-visible,
  .photos:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .slider-animal .photos {
    width: 100%;
    aspect-ratio: 1;
    max-height: 320px;
  }

  .slider-animal figure {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }

  .slider-animal .photos img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: auto;
    object-fit: contain;
    border-radius: 12px;
  }

  .thumbnails:not([hidden]) {
    position: static;
    transform: none;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    padding: 0;
    background: transparent;
  }

  .thumbnails .dot {
    box-sizing: border-box;
    display: block;
    width: 56px;
    height: 56px;
    padding: 4px;
    border: 2px solid transparent;
    border-radius: 12px;
  }

  .thumbnails .dot::after {
    display: none;
  }

  .thumbnails .dot[aria-current='true'] {
    border-color: var(--color-primary);
  }

  .thumbnails img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  @media (max-width: 55rem) and (min-width: 48rem), (max-width: 35rem) {
    .slider-hero .photos img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
