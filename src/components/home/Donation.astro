---
import { Heart } from '@lucide/astro'
---

<section class="donation" id="doacoes" aria-labelledby="donation-title">
  <div class="card">
    <h2 id="donation-title">
      Doações e vendas ajudam a manter nosso trabalho pelos animais
    </h2>

    <button class="button" type="button" data-open-pix hidden>
      Contribuir com Pix
      <Heart size={18} aria-hidden="true" />
    </button>
    <noscript>
      <a class="button" href="#contribuir">
        Contribuir com Pix
        <Heart size={18} aria-hidden="true" />
      </a>
    </noscript>
  </div>
</section>

<style>
  .donation {
    padding: 24px 24px 32px;
    background: var(--color-primary);
  }

  .card {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: center;
    gap: 32px;
    max-width: 1120px;
    box-sizing: border-box;
    margin-inline: auto;
    padding: 28px 32px;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background: var(--color-soft);
    color: var(--color-text);
  }

  .card > * {
    min-width: 0;
  }

  h2 {
    margin: 0;
    color: var(--color-primary);
    font-size: 24px;
  }

  .button {
    width: 100%;
  }

  @media (max-width: 62rem) {
    .card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 24px;
      gap: 24px;
    }
  }

  @media (max-width: 35rem) {
    .donation {
      padding: 16px 16px 24px;
    }

    .card {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 20px;
    }
  }
</style>
