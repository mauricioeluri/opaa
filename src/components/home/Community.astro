---
import { ArrowUpRight, PawPrint, Shirt, Stethoscope } from '@lucide/astro'
import { getPosts, getStories, homeLimits } from '../../lib/api'
import { postCategories } from '../../lib/post-category'
import { getContentImage } from '../../lib/content-image'
import ContentImage from '../ContentImage.astro'

const posts = (await getPosts()).slice(0, homeLimits.posts)
const stories = (await getStories()).slice(0, homeLimits.stories)
const storyImages = await Promise.all(
  stories.map((story) => getContentImage(story.afterImage))
)
---

<div class="community">
  {posts.length > 0 && (
    <section id="novidades" aria-labelledby="news-title">
      <header>
        <h2 id="news-title">
          <a class="heading-link" href="/publicacoes/">
            Acontece na OPAA
          </a>
        </h2>
        <a class="section-link" href="/publicacoes/">
          Ver publicações
          <ArrowUpRight size={18} aria-hidden="true" />
        </a>
      </header>
      <div class="highlights">
        {posts.map((post) => (
          <a class="highlight" href={`/publicacoes/${post.slug}/`}>
            {post.image ? (
              <ContentImage
                class="cover"
                src={post.image}
                alt=""
                width={480}
                sizes="auto, (max-width: 35rem) 112px, 180px"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="illustration" aria-hidden="true">
                <Stethoscope size={48} stroke-width={1.5} />
              </span>
            )}
            <p class="category">
              {postCategories[post.category] ?? 'Publicações'}
            </p>
            <h3>{post.title}</h3>
            <p class="description">{post.body}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="shop" id="loja" aria-labelledby="shop-title">
    <a class="shop-card" href="/loja/" aria-labelledby="shop-title">
      <span class="shop-illustration" aria-hidden="true">
        <Shirt size={76} stroke-width={1.5} />
        <PawPrint class="shirt-paw" size={20} stroke-width={2} />
      </span>
      <div class="shop-copy">
        <span class="shop-label">Loja solidária</span>
        <h2 id="shop-title">Leve essa causa com você</h2>
        <p>Uma compra sua também pode virar cuidado.</p>
      </div>
      <PawPrint
        class="shop-decoration"
        size={176}
        stroke-width={1}
        aria-hidden="true"
      />
    </a>
  </section>

  <section id="historias-felizes" aria-labelledby="stories-title">
    <header>
      <h2 id="stories-title">
        <a class="heading-link" href="/historias-felizes/">
          Histórias felizes
        </a>
      </h2>
      <a class="section-link" href="/historias-felizes/">
        Ver todas as histórias
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </header>
    <div class="photo-album">
      {stories.map((story, index) => {
        const image = storyImages[index]
        const cropScale = Math.max(1, image.width / image.height)
        return (
          <a
            class="photo-print"
            href="/historias-felizes/"
            aria-label={`Ver histórias felizes — ${story.name}`}
          >
            <figure>
              <ContentImage
                src={story.afterImage}
                alt={`Foto atual de ${story.name}`}
                width={640}
                sizes={`(max-width: 35rem) ${30 * cropScale}vw, ${160 * cropScale}px`}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{story.name}</figcaption>
            </figure>
          </a>
        )
      })}
    </div>
  </section>
</div>

<style>
  .community {
    max-width: 1120px;
    margin-inline: auto;
    padding: 0 24px var(--section-gap);
  }

  section + section {
    margin-top: var(--section-gap);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    color: var(--color-primary);
    font-size: clamp(24px, 3vw, 32px);
  }

  .category,
  .description {
    margin: 0;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .section-link:hover,
  .highlight:hover h3 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .highlights {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .highlight {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    column-gap: 24px;
    align-content: start;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .cover,
  .illustration {
    display: flex;
    grid-row: 1 / 4;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    border-radius: 16px;
    object-fit: contain;
    background: var(--color-soft);
  }

  .illustration {
    position: relative;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-soft);
    color: var(--color-primary);
  }

  .illustration::after {
    position: absolute;
    right: -8px;
    bottom: -24px;
    width: 120px;
    height: 120px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    content: '';
  }

  .category {
    color: var(--color-primary);
    font-size: 12px;
  }

  h3 {
    margin: 4px 0 8px;
    font-size: 20px;
  }

  .description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 14px;
  }

  .shop-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    align-items: center;
    gap: 28px;
    padding: 28px 32px;
    overflow: hidden;
    border-radius: 28px 8px 28px 8px;
    background: var(--color-primary);
    color: var(--color-surface);
    text-decoration: none;
  }

  .shop-illustration {
    position: relative;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border-radius: 22px;
    background: var(--color-soft);
    color: var(--color-primary);
    transform: rotate(-8deg);
    transition: transform 200ms ease;
  }

  .shop-illustration :global(.shirt-paw) {
    position: absolute;
    top: 52px;
    left: 46px;
  }

  .shop-copy {
    min-width: 0;
  }

  .shop-label {
    display: inline-block;
    padding: 2px 10px;
    margin-bottom: 10px;
    border-radius: 4px;
    background: var(--color-soft);
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    transform: rotate(-2deg);
  }

  .shop h2 {
    margin-bottom: 8px;
    color: inherit;
    font-size: clamp(26px, 3vw, 34px);
  }

  .shop-copy p {
    margin: 0;
    font-size: 15px;
  }

  .shop-card :global(.shop-decoration) {
    position: absolute;
    right: 32px;
    bottom: -52px;
    z-index: -1;
    opacity: 0.1;
    transform: rotate(18deg);
    pointer-events: none;
  }

  .shop-card:hover .shop-illustration {
    transform: rotate(-3deg);
  }

  .shop-card:hover {
    background: var(--color-primary-hover);
  }

  .photo-album {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: start;
    gap: 20px;
    padding: 12px 8px;
  }

  .photo-print {
    position: relative;
    min-width: 0;
    margin: 0;
    padding: 8px 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    box-shadow: 0 4px 8px color-mix(in srgb, var(--color-text) 12%, transparent);
    text-decoration: none;
  }

  .photo-print figure {
    margin: 0;
  }

  .photo-print:nth-child(3n + 1) {
    transform: rotate(-3deg);
  }

  .photo-print:nth-child(3n + 2) {
    transform: rotate(2deg);
  }

  .photo-print:nth-child(3n) {
    transform: rotate(-1deg);
  }

  .photo-print::before {
    position: absolute;
    top: -8px;
    left: calc(50% - 20px);
    z-index: 1;
    width: 40px;
    height: 14px;
    background: color-mix(in srgb, var(--color-primary) 20%, transparent);
    transform: rotate(-6deg);
    clip-path: polygon(3% 0, 100% 5%, 97% 95%, 0 100%);
    content: '';
  }

  .photo-print img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 6px;
    object-fit: cover;
  }

  figcaption {
    padding-top: 8px;
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    overflow-wrap: anywhere;
  }

  @media (max-width: 47.999rem) {
    .section-link {
      display: none;
    }
  }

  @media (max-width: 45rem) {
    .highlights {
      gap: 16px;
    }

    .shop-card {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 20px;
      padding: 24px;
    }

    .shop-illustration {
      width: 96px;
      height: 96px;
    }

    .shop-illustration :global(.shirt-paw) {
      top: 44px;
      left: 38px;
    }
  }

  @media (max-width: 35rem) {
    .community {
      padding-inline: 16px;
    }

    .highlights {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .highlight {
      grid-template-columns: 112px minmax(0, 1fr);
      column-gap: 16px;
    }

    .cover,
    .illustration {
      border-radius: 12px;
    }

    .category {
      margin-top: 0;
    }

    h3 {
      margin-block: 4px 8px;
      font-size: 18px;
    }

    .illustration::after {
      width: 64px;
      height: 64px;
    }

    .shop-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .shop-illustration {
      display: none;
    }

    .photo-album {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 12px;
      padding-inline: 6px;
    }

    .photo-print {
      padding: 5px 5px 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-illustration {
      transition: none;
    }

    .shop-card:hover .shop-illustration {
      transform: none;
    }
  }
</style>
