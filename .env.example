# =====================================================================
# SEO settings: canonical URLs, search indexing, and site verification.
# Optional for local development. Applied when building the site.
# =====================================================================

# Required for production SEO: enter the confirmed HTTPS origin.
# Canonical URLs, social image URLs, and the sitemap use this value.
# No paths, query parameters, or fragments. The domain is not confirmed yet.
SITE_URL=

# Enable only when production content is ready and SITE_URL is configured.
# Disabling indexing does not make the website private.
SITE_INDEXABLE=false

# Optional: paste the content value from each service verification meta tag.
# Leave empty if using DNS verification. These codes cannot be generated here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# =====================================================================
# Todapata API: where the site gets its content, read on the server on every
# page view (never sent to the browser). Both are required: without them the
# pages show the "unavailable" screen. In production they are secrets of the
# Cloudflare Worker, not build variables; locally they come from this file.
# For local development against a Todapata on this computer, see `pnpm dev:local`.
# The key is created by the Todapata administrator for this ONG.
# =====================================================================

# Base address of the API, no trailing path (locally: http://localhost:3000).
TODAPATA_API_URL=

# Secret key of the ONG. Never commit it: keep it only in the real .env or in
# the Worker secrets of the hosting service.
TODAPATA_API_KEY=
