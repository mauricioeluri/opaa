# =====================================================================
# SEO settings: canonical URLs, search indexing, and site verification.
# Optional for local development. Applied when building the static site.
# =====================================================================

# Required for production SEO: enter the confirmed HTTPS origin.
# Canonical URLs, social image URLs, and the sitemap use this value.
# No paths, query parameters, or fragments. The domain is not confirmed yet.
SITE_URL=

# Enable only when production content is ready and SITE_URL is configured.
# Disabling indexing does not make the website private.
SITE_INDEXABLE=false

# Optional: paste the content value from each service verification meta tag.
# Leave empty if using DNS verification. These codes cannot be generated here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
