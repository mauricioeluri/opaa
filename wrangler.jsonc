{
  "name": "opaa-alegrete",
  "compatibility_date": "2026-11-01",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // Read by the Worker on every request. The address is not sensitive, so it
  // lives here, versioned; locally `.env` (or `.env.todapata-local`) wins.
  // The key, TODAPATA_API_KEY, is a Worker secret (Settings → Runtime
  // variables and secrets, or `wrangler secret put`): never put it here.
  "vars": {
    "TODAPATA_API_URL": "https://todapata.customsys.com.br"
  }
}
