{
  "name": "opaa-alegrete",
  "compatibility_date": "2026-11-01",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
  // TODAPATA_API_URL and TODAPATA_API_KEY are Worker secrets (dashboard or
  // `wrangler secret put`), read on every request; locally they come from `.env`.
}
